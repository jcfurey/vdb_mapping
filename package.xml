<?xml version="1.0"?>
<package format="3">
  <name>vdb_mapping</name>
  <version>0.1.0</version>
  <description>The vdb_mapping core package used for fast performant volumetric mapping.</description>

  <maintainer email="grosse@fzi.de">Marvin Große Besselmann</maintainer>

  <license>Apache-2.0</license>

  <url type="repository">https://github.com/fzi-forschungszentrum-informatik/vdb_mapping</url>

  <author email="grosse@fzi.de">Marvin Große Besselmann</author>
  <author email="puck@fzi.de">Lennart Puck</author>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libopenvdb-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libpcl-all</depend>
  <depend>tbb</depend>
  <depend>libzstd-dev</depend>

  <test_depend>libgtest-dev</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
